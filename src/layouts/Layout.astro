---
import Favicon from "./components/Favicon.astro";
import MetadataSEO from "./components/MetadataSEO.astro";
import Footer from "./components/Footer.astro";

interface Props {
  metadescription: string;
  title: string;
}
const { metadescription, title } = Astro.props;

//Import CSS
import "../assets/css/main.css";
---

<!doctype html>
<html lang='it'>
  <head>
    <Favicon />
    <MetadataSEO title={title} metadescription={metadescription} />
  </head>
  <body>
    <slot />
    <Footer />
  </body>
</html>
