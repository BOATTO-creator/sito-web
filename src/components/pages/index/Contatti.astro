<style>
  .contatti-sede {
    margin-bottom: 1rem;
    padding: 1rem;
    border-radius: var(--radius-boatto);
    cursor: pointer;
    border: 1px solid transparent;
  }
  .contatti-sede:hover {
    border: 1px solid var(--color-light-gray-boatto);
  }
  .contatti-sede h3 {
    margin-bottom: 0.5rem;
  }
  .contatti-maps {
    width: 100%;
  }
  .contatti-maps iframe {
    max-width: 60rem;
    max-height: 30rem;
    width: 100%;
    margin-left: auto;
  }

  @media screen and (max-width: 48rem) {
    .contatti-maps iframe {
      width: 100%;
    }
  }
  .is-hidden {
    display: none;
  }
  .is-active {
    background-color: var(--color-light-gray-boatto);
  }
</style>

<section id='contatti' class='mx-4 lg:mx-16 mt-16 md:mt-32'>
  <h2 class='font-alexandria-r mb-4'>Dove trovarci</h2>
  <div class='flex justify-between gap-4 flex-col-reverse md:flex-row'>
    <div>
      <div class='contatti-sede contatti-sede--amministrativa is-active'>
        <h3>Sede legale e ammisitrativa</h3>
        <a
          href='https://maps.app.goo.gl/AWnBsVXZm4nA3ToaA'
          target='_blank'
          rel='noopener noreferrer'
        >
          Via F. Petrarca 9 <br />
          30038 Spinea (VE)
        </a>
      </div>
      <div class='contatti-sede contatti-sede--magazzino'>
        <h3>Parco mezzi e deposito</h3>
        <a
          href='https://maps.app.goo.gl/ihMRh9LJqEXRdvWe7'
          target='_blank'
          rel='noopener noreferrer'
        >
          V. Cavin di Sala, 193/195 <br />
          30035 Mirano (VE)
        </a>
      </div>
      <div>
        <h3>Contatti</h3>
        <p><a href='tel:+39041992100'>041992100</a></p>
        <p>
          <a href='mailto:info@boattoautotrasporti.com'
            >info@boattoautotrasporti.com</a
          >
        </p>
        <p>P.IVA 03588220271</p>
        <p>Boatto Autotrasporti S.r.l.</p>
      </div>
    </div>
    <!-- google maps -->
    <div data-map-type='amministrativa' class='contatti-maps mb-4'>
      <iframe
        src='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2796.5317550407285!2d12.1516204!3d45.4993732!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x477eca14374405ab%3A0xe261363d0fe672c3!2sBoatto%20Autotrasporti%20S.R.L.!5e0!3m2!1sit!2sit!4v1787247761217!5m2!1sit!2sit'
        width='600'
        height='450'
        style='border:0;'
        allowfullscreen=''
        loading='lazy'
        referrerpolicy='strict-origin-when-cross-origin'></iframe>
    </div>

    <div data-map-type='magazzino' class='contatti-maps mb-4 is-hidden'>
      <iframe
        src='https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2796.6152543873263!2d12.069738669210322!3d45.49769199192994!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x477ecc074fc01739%3A0x62014a8f3c8ab322!2sV.%20Cavin%20di%20Sala%2C%20193%2F195%2C%2030035%20Mirano%20VE!5e0!3m2!1sit!2sit!4v1787246954343!5m2!1sit!2sit'
        width='600'
        height='450'
        style='border:0;'
        allowfullscreen=''
        loading='lazy'
        referrerpolicy='strict-origin-when-cross-origin'></iframe>
    </div>
  </div>
</section>

<script>
  const contattiCards = document.querySelectorAll(".contatti-sede");
  const maps = document.querySelectorAll(".contatti-maps");

  contattiCards.forEach((card, index) => {
    card.addEventListener("click", () => {
      // Remove active class from all cards
      contattiCards.forEach((el) => {
        el.classList.remove("is-active");
      });

      // Add active class to clicked card
      card.classList.add("is-active");

      // Hide all maps
      maps.forEach((map) => {
        map.classList.add("is-hidden");
      });

      // Show the map with the same index
      if (maps[index]) {
        maps[index].classList.remove("is-hidden");
      }
    });
  });

  // Show first map by default
  if (maps.length > 0) {
    maps.forEach((map) => map.classList.add("is-hidden"));
    maps[0].classList.remove("is-hidden");
  }
</script>
