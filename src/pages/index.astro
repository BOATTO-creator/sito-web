---
import Layout from "../layouts/Layout.astro";
import BannerDati from "../components/pages/index/BannerDati.astro";
import Storia from "../components/pages/index/Storia.astro";
import CTA from "../components/pages/index/CTA.astro";
import Servizi from "../components/pages/index/Servizi.astro";
import Contatti from "../components/pages/index/Contatti.astro";
import Preventivo from "../components/pages/index/preventivo/Preventivo.tsx";
import Header from "../layouts/components/Header.astro";
---

<style>
  .hero {
    background-image:
      linear-gradient(to left, rgba(0, 0, 0, 0.3), transparent 60%),
      url("/img/boatto-payoff-truck-desktop.jpg");
    background-position: center;
    background-size: cover;
    position: relative;
    height: 100dvh;
  }
  @media (width <= 40rem /* 640px sm */) {
    .hero {
      background-image:
        linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0.5),
          rgba(0, 0, 0, 0.1) 59%
        ),
        url("/img/boatto-payoff-truck-mobile.jpg");
    }
  }
</style>

<Layout
  metadescription='Boatto Autotrasporti offre servizi di trasporto ADR, FRC/FNA e logistica a Spinea (VE). La direzione giusta per ogni viaggio.'
  title='Boatto Autotrasporti | Trasporti ADR e Logistica a Spinea'
>
  <section class='hero'>
    <Header />
    <h1
      class='max-w-[15ch] font-alexandria-b text-left bottom-[10%] md:left-14 text-white absolute mx-4'
    >
      La direzione giusta per ogni viaggio.
    </h1>
  </section>

  <BannerDati />
  <Storia />
  <CTA />
  <Servizi />
  <Contatti />
  <!-- Netlify elaborates form data only coming from a HTML form. React doesn't send anything.
  To fix this I had to create a invisible form that gets the data from React and this actually sends it. -->
  <form name='form-preventivo' method='POST' data-netlify='true' hidden>
    <!-- <input type='hidden' name='form-name' value='form-preventivo' /> -->
    <input type='text' name='nome' />
    <input type='text' name='cognome' />
    <input type='text' name='azienda' />
    <input type='text' name='piva' />
    <input type='email' name='email' />
    <input type='tel' name='telefono' />
    <input type='text' name='indirizzoDiCarico' />
    <input type='text' name='indirizzoDiScarico' />
    <input type='text' name='tipologiaCarico' />
    <input type='text' name='dataProntezzaMerce' />
    <input type='text' name='larghezza' />
    <input type='text' name='altezza' />
    <input type='text' name='peso' />
    <input type='text' name='numeroPezzi' />
    <textarea name='infoAggiuntive'></textarea>
    <input type='checkbox' name='datiPersonali' />
  </form>
  <Preventivo client:idle />
</Layout>

<script>
  import gsap from "gsap";

  gsap.from(".hero h1", {
    autoAlpha: 0,
    y: 200,
    duration: 1,
    ease: "power1.out",
  });
</script>
